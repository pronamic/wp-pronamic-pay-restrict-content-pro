#. Plugin Name of the plugin
#: pronamic-pay-restrict-content.php:3
msgid "Pronamic Pay Restrict Content (Pro) Add-On"
msgstr "Pronamic Pay Restrict Content (Pro) add-on"

#. Plugin URI of the plugin
#: pronamic-pay-restrict-content.php:4
msgid "https://www.pronamic.eu/plugins/pronamic-pay-restrict-content-pro/"
msgstr "https://www.pronamic.eu/plugins/pronamic-pay-restrict-content-pro/"

#. Description of the plugin
#: pronamic-pay-restrict-content.php:5
msgid "Extend the Pronamic Pay plugin with Restrict Content (Pro) support to receive payments through a variety of payment providers."
msgstr "Breid de Pronamic Pay plugin uit met ondersteuning voor Restrict Content (Pro) om betalingen te ontvangen via verschillende betaalproviders."

#. Author of the plugin
#: pronamic-pay-restrict-content.php:11 src/Gateways/Gateway.php:330
#: src/Gateways/Gateway.php:357
msgid "Pronamic"
msgstr "Pronamic"

