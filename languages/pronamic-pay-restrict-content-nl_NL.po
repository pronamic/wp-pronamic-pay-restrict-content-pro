#: src/Gateways/Gateway.php:158
msgid "Creating a subscription with an immediate charge is not supported."
msgstr "Het aanmaken van een abonnement met een directe afschrijving wordt niet ondersteund."

#: src/Gateways/Gateway.php:170
msgid "The membership is not active."
msgstr "Het lidmaatschap is niet actief."

#: src/Gateways/Gateway.php:179
msgid "The membership is not changed from a previous membership."
msgstr "Het lidmaatschap is niet gewijzigd vanuit een eerder lidmaatschap."

#: src/Gateways/Gateway.php:190
msgid "The previous membership has no Pronamic Pay subscription."
msgstr "Het vorige lidmaatschap heeft geen Pronamic Pay abonnement."

#. translators: 1: previous Restrict Content Pro membership ID, 2: new Restrict Content Pro membership ID
#: src/Gateways/Gateway.php:216
#, php-format
msgid "Subscription moved from Restrict Content Pro membership %1$s to membership %2$s because the membership level was changed."
msgstr "Abonnement verplaatst van Restrict Content Pro lidmaatschap %1$s naar lidmaatschap %2$s omdat het lidmaatschapsniveau is gewijzigd."

#. translators: 1: Pronamic Pay subscription ID, 2: new Restrict Content Pro membership ID
#: src/Gateways/Gateway.php:239
#, php-format
msgid "Pronamic Pay subscription %1$s moved to membership %2$s."
msgstr "Pronamic Pay abonnement %1$s verplaatst naar lidmaatschap %2$s."

#. translators: 1: Pronamic Pay subscription ID, 2: previous Restrict Content Pro membership ID
#: src/Gateways/Gateway.php:257
#, php-format
msgid "Pronamic Pay subscription %1$s moved from membership %2$s."
msgstr "Pronamic Pay abonnement %1$s verplaatst vanuit lidmaatschap %2$s."

