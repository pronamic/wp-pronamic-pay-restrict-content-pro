{
	"name": "wp-pay-extensions/restrict-content-pro",
	"description": "Restrict Content (Pro) driver for the WordPress payment processing library.",
	"keywords": [
		"wordpress",
		"wp",
		"pay",
		"restrict",
		"content",
		"pro",
		"extension",
		"pronamic"
	],
	"homepage": "http://www.wp-pay.org/extensions/restrict-content-pro/",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "http://www.pronamic.eu/",
			"role": "Company"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@wp-pay.org",
		"issues": "https://github.com/wp-pay-extensions/restrict-content-pro/issues",
		"source": "https://github.com/wp-pay-extensions/restrict-content-pro"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Pay\\Extensions\\RestrictContent\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true,
			"phpstan/extension-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true,
		"wp-slug": "pronamic-pay-restrict-content",
		"platform-check": false
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:wp-pay",
				"vendor:wp-pay-extensions",
				"vendor:wp-pay-gateways",
				"woocommerce/action-scheduler"
			]
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://repo.wp-packages.org"
		}
	],
	"require": {
		"php": ">=8.3",
		"automattic/jetpack-autoloader": "^3.0 || ^4.0 || ^5.0 || ^6.0",
		"composer/installers": "^2.3",
		"pronamic/wp-money": "^2.5",
		"pronamic/wp-number": "^1.4",
		"woocommerce/action-scheduler": "^3.9 || ^4.0",
		"wp-pay/core": "^4.35"
	},
	"require-dev": {
		"php-coveralls/php-coveralls": "^2.9",
		"phpmd/phpmd": "^3.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.8",
		"roots/wordpress": "^7.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"vimeo/psalm": "^6.5",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-phpunit/wp-phpunit": "^7.1",
		"wp-plugin/restrict-content": "^4.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-restrict-content/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-restrict-content/ --slug=pronamic-pay-restrict-content",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-restrict-content/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-restrict-content/ --plugin-dirname=pronamic-pay-restrict-content --force"
		],
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-restrict-content/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-restrict-content.pot"
		],
		"coveralls": "vendor/bin/php-coveralls -v",
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v",
		"phplint": "find src tests -name '*.php' | xargs -n 1 -P 4 php -l",
		"phpmd": "vendor/bin/phpmd src,tests text phpmd.ruleset.xml --suffixes php",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"phpunit": "vendor/bin/phpunit --colors=always",
		"psalm": "vendor/bin/psalm"
	}
}
